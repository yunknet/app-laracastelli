# URL do domínio HTTPS do app (sem barra no final)
APP_ORIGIN=https://app.laracastelli.mivaia.com

# PostgreSQL (no Docker Compose do projeto, db é o nome do container):
DATABASE_URL=postgresql://lara:lara_secret_change_me@db:5432/lara

# Se usar PostgreSQL do Easypanel ou outro host externo:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Credenciais usadas pelo container db no docker compose:
POSTGRES_DB=lara
POSTGRES_USER=lara
POSTGRES_PASSWORD=lara_secret_change_me

# Token de autenticação do Webhook Lastlink (opcional, para reforçar segurança)
LASTLINK_TOKEN=aa47b009b5ee4a15a783d1c03d779edd
TRUST_PROXY=1
